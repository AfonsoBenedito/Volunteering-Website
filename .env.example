# Copy this file to .env for local development (without Docker Compose).
# When using docker-compose.yml these values are set directly in the compose file.

# HTTP port (Cloud Run sets this automatically; default 8080)
PORT=8080

# 32+ random bytes for encrypting session cookies — CHANGE IN PRODUCTION
# Generate with: openssl rand -hex 32
SESSION_KEY=change-me-to-a-long-random-secret-string

# Admin panel credentials (HTTP Basic Auth at /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# GCS bucket for user photo uploads (leave empty to use local ./uploads/ directory)
# Create bucket: gsutil mb -l europe-west1 gs://your-bucket-name
# Make sure the Cloud Run service account has Storage Object Admin on this bucket.
STORAGE_BUCKET=
